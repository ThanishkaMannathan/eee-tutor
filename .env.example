# ============================================================
#  .env.example  —  Copy this to .env and fill in your values
#  NEVER commit your real .env file to Git!
# ============================================================

# --- Telegram ---
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your personal Telegram chat ID (run /start on the bot, then check logs)
YOUR_TELEGRAM_CHAT_ID=123456789

# --- Anthropic Claude API ---
# Get this from https://console.anthropic.com/
CLAUDE_API_KEY=sk-ant-your_claude_api_key_here

# --- Study Preferences ---
# Time to send the daily lesson (24-hour format, your local time)
STUDY_TIME=08:00

# Your year of study (1, 2, 3, or 4)
STUDENT_YEAR=2

# Your level: beginner / intermediate / advanced
STUDENT_LEVEL=beginner

# --- Optional: Timezone ---
# e.g. Asia/Kolkata, America/New_York, Europe/London
TIMEZONE=Asia/Kolkata
